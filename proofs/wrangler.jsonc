{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofs",
  "compatibility_date": "2026-02-20",
  // An independent index of the openai/math release (722 papers, 372 result
  // families) plus interactive pages for the results that allow one. No build:
  // the directory IS the site. data.js and abstracts.json are generated by
  // build.mjs from a clone of the release and committed; see CLAUDE.md.
  // Internal files are kept out by .assetsignore.
  //
  // worker.js adds ONE endpoint, POST /api/ask (the decks' chatbot, Workers AI).
  // Assets are matched first; the script only sees requests no file matched.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": { "binding": "AI" },
  // per-IP limit on /api/ask: 8 questions a minute
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "4207", "simple": { "limit": 8, "period": 60 } }
  ],
  // A PLAIN ROUTE, not a custom domain (the zone's custom-domain slots are not
  // spent on new surfaces). A route makes no DNS, so deploy-proofs.yml runs
  // scripts/route-dns.mjs before wrangler deploy.
  "routes": [
    { "pattern": "proofs.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
