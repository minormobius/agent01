{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iris",
  "main": "worker.js",
  "compatibility_date": "2026-03-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // GOLDEN RULE: this `name` must be the worker that owns the live custom domain, and the
  // domain must be declared here as a custom_domain route — otherwise wrangler silently
  // updates a stray iris.workers.dev and the subdomain never changes. Verify the deploy log
  // binds "iris.mino.mobi (custom domain)".
  // A PLAIN ROUTE (2026-09-23), converted from a custom domain to free one of the
  // zone's 100 slots; the host and every URL on it are unchanged (converted live by
  // cf-ops convert-to-route, .github/cf-ops/plan.json batch 2). A route makes no DNS, so
  // the deploy workflow runs scripts/route-dns.mjs to ensure the proxied record exists.
  // Do not turn it back into a custom_domain.
  "routes": [
    { "pattern": "iris.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
