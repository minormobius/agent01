{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mappa",
  "compatibility_date": "2026-02-20",
  // Assets-only worker. The deploy workflow assembles ../.mappa-stage: mappa/ (minus
  // this config, test/, engine-rs/ sources, and civ/ — the civ engine ships on the
  // civ surface) plus the two runtime ES-module imports viewer.js pulls from outside
  // the directory (packages/atproto/pds.js, packages/oauth-client/auth.js) staged
  // under /packages/ so `../../packages/…` resolves on this origin. Never deploy
  // from mappa/ directly — the stage is the asset root.
  "assets": {
    "directory": "../.mappa-stage"
  },
  // A PLAIN ROUTE (2026-09-23), converted from a custom domain to free one of the
  // zone's 100 slots; the host and every URL on it are unchanged (converted live by
  // cf-ops convert-to-route, .github/cf-ops/plan.json batch 2). A route makes no DNS, so
  // the deploy workflow runs scripts/route-dns.mjs to ensure the proxied record exists.
  // Do not turn it back into a custom_domain.
  "routes": [
    { "pattern": "mappa.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
