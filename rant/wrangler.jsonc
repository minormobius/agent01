{
  // rant.mino.mobi — the standard.site publication engine.
  //
  // THE GOLDEN RULE (docs/DEPLOYS.md §4): `name` must be the worker that owns
  // the live custom domain, and that domain must appear in `routes` with
  // `custom_domain: true`. Otherwise `wrangler deploy` goes green while
  // updating a stray `rant.workers.dev` and the live site never changes.
  // Verify a deploy by finding `rant.mino.mobi (custom domain)` in its log.
  //
  // `main` is generated: `worker-build` compiles crates/rant-worker to wasm and
  // emits the module shim. There is no hand-written JavaScript entry point.
  //
  // worker-build must run from the crate directory (it parses the crate's own
  // Cargo.toml and refuses a [workspace] root), and it writes to ./build/worker
  // relative to that directory — hence both the `cd` and the nested `main` path.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rant",
  "main": "crates/rant-worker/build/index.js",
  "compatibility_date": "2026-03-14",
  "routes": [
    { "pattern": "rant.mino.mobi", "custom_domain": true }
  ],
  //
  // The install is GUARDED. `cargo install` exits 101 with "binary already
  // exists in destination" rather than no-op'ing, so an unguarded install fails
  // on every run after the first — and the deploy workflow caches
  // ~/.cargo/bin/worker-build, which guarantees it is there. Run #1 passed on a
  // cold cache and run #2 failed on a warm one.
  "build": {
    "command": "command -v worker-build >/dev/null 2>&1 || cargo install -q worker-build --locked; cd crates/rant-worker && worker-build --release"
  },
  "assets": {
    // The stylesheet, the composer shell, and pkg/ (the browser wasm module).
    // Everything else is rendered by the worker.
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://rant.mino.mobi",
    "PUBLICATION_NAME": "Rant",
    "PUBLICATION_DESCRIPTION": "A box to rant into. Posts are standard.site records in your own repo.",
    // The house publication.
    //
    // PUBLICATION_DID is the repo the site looks in. From it the worker resolves
    // the `site.standard.publication` record whose `url` is SITE_URL — so
    // pressing the button at /setup/ is the whole of linking a publication;
    // there is no URI to paste back here and no deploy to wait for. Matching on
    // `url` is what makes it safe to look in a person's repo: this DID also owns
    // a Leaflet publication, and that one is not this site.
    //
    // PUBLICATION_URI pins the answer and skips the lookup. Leave it empty
    // unless you want to save the (hour-cached) round trip. While no record
    // matches, /.well-known/site.standard.publication 404s with an explanation
    // rather than claiming a publication that isn't there — which is a legal
    // state, not a broken one: documents then carry the site URL as their `site`
    // field, which the lexicon allows for loose documents.
    "PUBLICATION_URI": "",
    "PUBLICATION_DID": "did:plc:7zre4plmd5jllccww575j6sb",
    "AUTH_URL": "https://auth.mino.mobi",
    "APPVIEW_URL": "https://public.api.bsky.app",
    "ACCENT": "#e4b363"
  }
}
