{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsky",
  "main": "worker.js",
  "compatibility_date": "2026-02-20",
  "routes": [
    { "pattern": "bsky.mino.mobi", "custom_domain": true }
    // NO dweet.mino.mobi ROUTE, and the reason is a hard platform limit rather
    // than a preference. It was here, and run #43 failed on it:
    //
    //   You have exceeded the limit of 100 Workers custom domains
    //   on zone 'mino.mobi'  [code: 100122]
    //
    // An extra custom_domain route is NOT free: it costs one of 100 custom
    // domains on the zone, and the zone is full. (That is a different cap from
    // the worker count, which is what this surface's docs originally blamed.)
    // Worse, the failure is at the TRIGGER step AFTER the assets upload, so the
    // run goes red while the new assets are already live — every push stays red
    // for as long as an unbindable route sits in this list.
    //
    // dweet therefore ships as a PATH: bsky.mino.mobi/dweet/. worker.js keeps
    // its hostname dispatch, inert until somebody frees a custom domain (that
    // is dashboard-only, docs/DEPLOYS.md §7) and re-adds the line above.
  ],
  // bsky.mino.mobi — a frontend-only AppView. The page assembles its own
  // timeline from Jetstream v2 (live tail, unauthenticated, server-side `dids`
  // filter over the follow graph) + Constellation (the global backlink index,
  // for engagement counts) + the public AppView (profile hydration only).
  //
  // The worker exists for ONE reason: Jetstream's replay/archive endpoints are
  // API-keyed and byte-metered, so history cannot be fetched from a static page
  // without publishing the key. /api/replay/* holds JETSTREAM_API_KEY and is
  // inert until deploy-bsky.yml injects it. Everything else falls through to
  // ASSETS. See docs/APPVIEW-FEASIBILITY.md §3.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
