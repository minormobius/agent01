{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsky",
  "main": "worker.js",
  "compatibility_date": "2026-02-20",
  "routes": [
    { "pattern": "bsky.mino.mobi", "custom_domain": true },
    // dweet.mino.mobi is a SECOND custom domain on this SAME worker, not a
    // second worker — the account is at its worker cap, and an extra route is
    // free where an extra worker is not. worker.js maps this host's `/` to
    // /dweet/index.html; every asset under /dweet/ is already reachable by its
    // own absolute path, so nothing else needs rewriting.
    //
    // Both patterns must appear in the deploy log as `(custom domain)`. If
    // only bsky.mino.mobi binds, dweet.mino.mobi is being served by something
    // else and this deploy did not change it — see the golden rule, below.
    { "pattern": "dweet.mino.mobi", "custom_domain": true }
  ],
  // bsky.mino.mobi — a frontend-only AppView. The page assembles its own
  // timeline from Jetstream v2 (live tail, unauthenticated, server-side `dids`
  // filter over the follow graph) + Constellation (the global backlink index,
  // for engagement counts) + the public AppView (profile hydration only).
  //
  // The worker exists for ONE reason: Jetstream's replay/archive endpoints are
  // API-keyed and byte-metered, so history cannot be fetched from a static page
  // without publishing the key. /api/replay/* holds JETSTREAM_API_KEY and is
  // inert until deploy-bsky.yml injects it. Everything else falls through to
  // ASSETS. See docs/APPVIEW-FEASIBILITY.md §3.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
