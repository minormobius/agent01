# Add to .gitignore
__pycache__/
*.py[cod]
*$py.class
.env
venv/
.venv/
env/

# Node
node_modules/
dist/

# Images live on the PDS, not in git
time/entries/figures/

# Full scored output is too large to commit (~6MB+ and growing)
# Only pool files (deep-pool.json, full-pool.json, pool.js) are committed
cards/data/deep-wikipedia.json

# Raw compound data too large for GitHub (130MB+)
data/yum-compounds.json

# Wrangler local state
.wrangler/

# j/ (ImageJ in the browser) — Rust build artifacts; pkg/ is rebuilt in CI
j/wasm/target/
j/pkg/
golem/js/vendor/
# board/ — deploy-time copy of packages/oauth-client/auth.js (scripts/vendor-board.sh)
board/vendor/
.polis-stage/
.mappa-stage/

# staged at deploy time by deploy-b.yml (see the staging steps) — never commit
b/lib/atproto/
b/packages/

# lab tenant manifests are build artefacts (scripts/gen-lab-tenants.mjs)
lab/*/tenants.json
lab/*/_kit/

# bake-off scratch: local per-cell run output (bakeoff/run-cell.sh). Real runs
# publish through bakeoff/results/, which IS committed.
bakeoff/.run/
# stray capture output if someone runs bakeoff/capture.mjs with an explicit --out
# inside the tree (the default is a temp dir)
*/capture/frame-*.png
