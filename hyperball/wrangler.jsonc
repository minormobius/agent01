{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperball",
  "compatibility_date": "2026-02-20",
  // HYPERBALL: bike-ball in four dimensions. The directory is the site (ASSETS); worker.js adds /avatar/<did> (Bluesky
  // avatars re-served from this origin so WebGL can texture them) and a small /xrpc/ gateway for the sign-in typeahead.
  // CLAUDE.md, the tests, this file and the worker's source are kept out of the upload by .assetsignore.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // A PLAIN ROUTE, not a custom domain: it costs none of the zone's custom-domain slots. A route makes no DNS, so
  // deploy-hyperball.yml runs scripts/route-dns.mjs before wrangler deploy.
  "routes": [
    { "pattern": "hyperball.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
