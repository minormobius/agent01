{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time",
  "compatibility_date": "2026-03-21",
  // time.mino.mobi — The Mino Times, a two-desk paper (Modulo = data desk,
  // Morphyx = institutional desk). Pure static assets, no build step; the
  // front page renders from index.json (built by scripts/build-time-index.mjs).
  // deploy-time.yml regenerates that manifest, then runs `wrangler deploy`
  // from this dir. Carved out of the root bundle so it owns its own subdomain.
  "assets": {
    "directory": "."
  },
  // A PLAIN ROUTE (2026-09-23), converted from a custom domain to free one of the
  // zone's 100 slots; the host and every URL on it are unchanged (converted live by
  // cf-ops convert-to-route, .github/cf-ops/plan.json batch 2). A route makes no DNS, so
  // the deploy workflow runs scripts/route-dns.mjs to ensure the proxied record exists.
  // Do not turn it back into a custom_domain.
  "routes": [
    { "pattern": "time.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
