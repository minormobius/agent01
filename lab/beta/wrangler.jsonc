{
  "$schema": "node_modules/wrangler/config-schema.json",
  // GOLDEN RULE: `name` must be the worker that owns beta.minomobi.com, and the
  // domain must appear in `routes` — otherwise wrangler updates a stray
  // beta.workers.dev and the live site never changes. Verify the deploy log
  // binds "beta.minomobi.com (custom domain)".
  "name": "beta",
  "compatibility_date": "2026-02-20",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "beta.minomobi.com", "custom_domain": true }
  ]
}
