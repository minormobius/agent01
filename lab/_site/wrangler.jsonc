{
  "$schema": "node_modules/wrangler/config-schema.json",
  // GOLDEN RULE: `name` must be the worker that owns lab.minomobi.com, and the
  // domain must appear in routes — otherwise wrangler updates a stray
  // lab.workers.dev and the live site never changes.
  "name": "lab",
  "main": "worker.js",
  "compatibility_date": "2026-02-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "lab.minomobi.com", "custom_domain": true }
  ],
  "vars": {
    // The Bluesky service account's DID, served at /.well-known/atproto-did so
    // the account can hold the handle `lab.minomobi.com`. Empty until the
    // account exists; the worker returns an explanatory 503 rather than a 404
    // while that is true. See lab/_site/CLAUDE.md for the ordering.
    "BOT_DID": ""
  }
}
