{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev",
  "main": "worker.js",
  "compatibility_date": "2026-03-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
    // NOT run_worker_first: nothing here needs to rewrite an asset response.
    // /api/ask and /api/health match no asset, so the worker still runs for
    // them; everything else is served straight off the asset store.
  },

  // GOLDEN RULE: this `name` must be the worker that owns the live custom
  // domain, and that domain must appear here as a custom_domain route —
  // otherwise `wrangler deploy` quietly updates a stray jev.workers.dev and
  // the subdomain never changes. Verify the deploy log binds
  // "jev.mino.mobi (custom domain)"; a green run is not proof.
  //
  // jev.mino.mobi was verified unclaimed on 2026-09-17 (it answered
  // identically to a nonsense subdomain — no DNS record), so the deploy that
  // binds it also creates the DNS record, which can take a few minutes to
  // propagate.
  //
  // KNOWN OBSTACLE, if a deploy fails here: the first attempt
  // (run 35188612508) uploaded the worker and then returned
  //   "You have exceeded the limit of 100 Workers custom domains on zone
  //    'mino.mobi'" [code: 100122]
  // That is a hard Cloudflare per-zone cap and the zone was at it. It cannot
  // be fixed from this directory — a slot has to be freed by detaching a
  // custom domain from a retired surface in the dashboard
  // (docs/DEPLOYS.md §7). Do NOT work around it by shipping to workers.dev
  // and repointing the catalogue; this surface targets jev.mino.mobi.
  "routes": [
    { "pattern": "jev.mino.mobi", "custom_domain": true }
  ]

  // The TypeSafe API key is NOT here. It is a secret:
  //   wrangler secret put TYPESAFE_API_KEY
  // or set the jev_key GitHub secret, which deploy-jev.yml pushes on every
  // run. Never put it in this file — assets.directory is "." and this whole
  // directory is served to the public internet.
}
