{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polis",
  "compatibility_date": "2026-02-20",
  // Assets-only worker. The deploy workflow assembles ../.polis-stage: everything in
  // polis/ plus the two out-of-tree ES-module imports the pages resolve at runtime
  // (mappa/engine.js, mappa/climate-forcing.js) staged under /mappa/ so the pages'
  // relative `../mappa/…` imports resolve on this origin exactly as they did under
  // the root site. Never deploy from polis/ directly — the stage is the asset root.
  "assets": {
    "directory": "../.polis-stage"
  },
  // A PLAIN ROUTE (2026-09-23), converted from a custom domain to free one of the
  // zone's 100 slots; the host and every URL on it are unchanged (converted live by
  // cf-ops convert-to-route, .github/cf-ops/plan.json batch 2). A route makes no DNS, so
  // the deploy workflow runs scripts/route-dns.mjs to ensure the proxied record exists.
  // Do not turn it back into a custom_domain.
  "routes": [
    { "pattern": "polis.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
