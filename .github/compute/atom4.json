{
 "run": "al2o3-dft",
 "why": "The ionic model's independent check: periodic PBE (PySCF) on our corundum and θ-alumina as measured and the ionic model's blind-search impostor, each scaled 0.98–1.04 isotropically. Corundum must come lowest; the gaps size what the model must get right.",
 "minutes": 300,
 "groups": [
  {
   "name": "dft-corundum",
   "cmds": [
    "node four/atom/tools/crystalref.mjs Al2O3 corundum 0.98",
    "node four/atom/tools/crystalref.mjs Al2O3 corundum 1.00",
    "node four/atom/tools/crystalref.mjs Al2O3 corundum 1.02",
    "node four/atom/tools/crystalref.mjs Al2O3 corundum 1.04"
   ]
  },
  {
   "name": "dft-theta",
   "cmds": [
    "node four/atom/tools/crystalref.mjs Al2O3 theta 0.98",
    "node four/atom/tools/crystalref.mjs Al2O3 theta 1.00",
    "node four/atom/tools/crystalref.mjs Al2O3 theta 1.02",
    "node four/atom/tools/crystalref.mjs Al2O3 theta 1.04"
   ]
  },
  {
   "name": "dft-impostor",
   "cmds": [
    "node four/atom/tools/crystalref.mjs Al2O3 impostor 0.98",
    "node four/atom/tools/crystalref.mjs Al2O3 impostor 1.00",
    "node four/atom/tools/crystalref.mjs Al2O3 impostor 1.02",
    "node four/atom/tools/crystalref.mjs Al2O3 impostor 1.04"
   ]
  }
 ]
}
