{
 "run": "of2-wells",
 "why": "OF₂ on its Dd-refitted field condenses with a critical point near 120 K against 258 measured. Random placements may miss the bottom of the pair well: the field's own 12 deepest pairs (from 0.47 to 0.31 kcal/mol on the field, deeper than any random placement's MP2), recomputed by MP2 in Dd, two per runner. If the true well is deeper there, the refit closes some of the gap.",
 "minutes": 330,
 "groups": [
  {
   "name": "of2well-0",
   "cmds": [
    "node four/atom/tools/molpair.mjs well OF2 0 --plus=Dd",
    "node four/atom/tools/molpair.mjs well OF2 1 --plus=Dd"
   ]
  },
  {
