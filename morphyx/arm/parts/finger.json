     "polygon": [
      [
       "-fin",
       "mx"
      ],
      [
       "ap + bk",
       "mx"
      ],
      [
       "ap + bk",
       "mx + ry + dy"
      ],
      [
       "ap - dx",
       "mx + ry + dy"
      ],
      [
       "ap",
       "mx + ry"
      ],
      [
       "ap - dx",
       "mx + ry - dy"
      ],
      [
       "ap - dx",
       "mx + pad"
      ],
      [
       "-fin",
       "mx + pad"
      ]
     ]
    }
   ]
  },
  {
