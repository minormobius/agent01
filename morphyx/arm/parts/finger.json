{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Jaw finger, two off: a 120° V that takes the can on four lines instead of two. The apex stands 18 mm outboard of the carrier's centre, which puts a Ø66 can at 4.1 mm of the 15 mm travel, with the V opening to Ø84.9 to get around it and closing to Ø58.9. The V is 13 deep in x and sits in the GAP between the carrier's two bolt columns, which is what lets the inboard pair be driven from the front into solid material — at 45° the V is 23 deep, covers both columns, and the counterbore has to break out obliquely on the gripping face. Two M4 there, and the two Ø5 dowels take the couple in shear. One extrude along +Z, then the bolts and the dowels as cuts along −Y.",
 "params": {
  "mx": 108,
  "ap": 18,
  "ry": 46,
  "dx": 13,
  "dy": 22.5167,
  "h": 26,
  "bk": 6,
  "fin": 7,
  "pad": 8,
  "d_b": 4.3,
  "d_d": 5,
  "dd": 8,
  "bx0": 0,
  "bx1": 11,
  "bz": 7
 },
 "features": [
  {
   "op": "sketch",
   "id": "plan",
   "plane": {
    "base": "XY",
    "offset": "-h / 2"
   },
   "loops": [
    {
