{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Base plate, lying in XY under everything. Four mounting holes. One extrude.",
 "params": {
  "w": 220,
  "y0": -48,
  "y1": 125,
  "t": 6,
  "top": -24,
  "d_mount": 4.5,
  "inset": 10
 },
 "features": [
  {
   "op": "sketch",
   "id": "outline",
   "plane": {
    "base": "XY",
    "offset": "top - t"
   },
   "loops": [
    {
     "name": "plate",
     "rect": {
      "c": [
       0,
       "(y0 + y1) / 2"
      ],
      "w": "w",
      "h": "y1 - y0"
     }
    }
   ]
  },
  {
   "op": "sketch",
   "id": "mount",
   "plane": {
    "base": "XY",
    "offset": "top - t"
   },
   "loops": [
    {
     "name": null,
     "circle": {
      "c": [
       "-w/2 + inset",
       "y0 + inset"
      ],
      "r": "d_mount / 2"
     }
    }
   ]
  },
  {
   "op": "pattern",
   "id": "mountsx",
   "of": "mount",
   "kind": "linear",
   "count": 2,
   "step": [
    "w - 2 * inset",
    0
   ],
   "name": "mount"
  },
  {
   "op": "pattern",
   "id": "mounts",
   "of": "mountsx",
   "kind": "linear",
   "count": 2,
   "step": [
    0,
    "y1 - y0 - 2 * inset"
   ],
   "name": "mount"
  },
  {
   "op": "extrude",
   "id": "base",
   "profile": [
    "outline",
    "mounts"
   ],
   "depth": "t"
  }
 ]
}
