{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Front wall, 104 wide, standing on the bed: the screw journal’s bearing (Ø6.2) on the mid-plane, and either side of it the slot a finger slide passes through (z ±6.2, x 5.5..38.5). The rail no longer hangs on this wall; it lies on the bed in front of it. One extrude along -Y.",
 "params": {
  "w": 104,
  "zb": -16,
  "zt": 27,
  "t": 6,
  "d_bore": 6.2,
  "sx0": 5.5,
  "sx1": 38.5,
  "sz": 6.2,
  "y1": 104
 },
 "features": [
  {
   "op": "sketch",
   "id": "face",
   "plane": {
    "base": "XZ",
    "offset": "-y1"
   },
   "loops": [
    {
     "name": "outline",
     "rect": {
      "c": [
       0,
       "(zb + zt) / 2"
      ],
      "w": "w",
      "h": "zt - zb"
     }
    },
    {
     "name": "bore",
     "circle": {
      "c": [
       0,
       0
      ],
      "r": "d_bore / 2"
     }
    },
    {
     "name": "slotR",
     "rect": {
      "c": [
       "(sx0 + sx1) / 2",
       0
      ],
      "w": "sx1 - sx0",
      "h": "2 * sz"
     }
    },
    {
     "name": "slotL",
     "rect": {
      "c": [
       "-(sx0 + sx1) / 2",
       0
      ],
      "w": "sx1 - sx0",
      "h": "2 * sz"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "plate",
   "profile": "face",
   "depth": "t"
  }
 ]
}
