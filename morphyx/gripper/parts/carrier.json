{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Jaw carrier: a 44 × 22 × 10 plate bolted to the outer face of its MGN9C block (four M3 on the block’s 10 × 15 pattern). The Ø4 link pin passes through its middle along Z with 22 mm of bearing, and a link seats on each face outside it. Its front face is the finger mount: four M4 and two Ø6 dowels, clear of the block behind. The pin hole is a cut along Z, the only boolean in this design. One extrude along +Y.",
 "params": {
  "half": 18,
  "hz": 11,
  "t": 10,
  "y1": 138,
  "px": 10,
  "pz": 15,
  "d_bolt": 3.4,
  "fx": 13,
  "fz": 7,
  "d_finger": 4.3,
  "dx": 13,
  "d_dowel": 6,
  "inset": 0,
  "d_pin": 4,
  "y_pin": 133
 },
 "features": [
  {
   "op": "sketch",
   "id": "face",
   "plane": {
    "base": "XZ",
    "offset": "-y1"
   },
   "loops": [
    {
     "name": "outline",
     "rect": {
      "c": [
       0,
       0
      ],
      "w": "2 * half",
      "h": "2 * hz"
     }
    },
    {
     "name": "blockA",
     "circle": {
      "c": [
       "-px/2",
       "-pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockB",
     "circle": {
      "c": [
       "px/2",
       "-pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockC",
     "circle": {
      "c": [
       "-px/2",
       "pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockD",
     "circle": {
      "c": [
       "px/2",
       "pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "fingerA",
     "circle": {
      "c": [
       "-fx",
       "-fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerB",
     "circle": {
      "c": [
       "fx",
       "-fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerC",
     "circle": {
      "c": [
       "-fx",
       "fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerD",
     "circle": {
      "c": [
       "fx",
       "fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "dowelA",
     "circle": {
      "c": [
       "-dx",
       0
      ],
      "r": "d_dowel / 2"
     }
    },
    {
     "name": "dowelB",
     "circle": {
      "c": [
       "dx",
       0
      ],
      "r": "d_dowel / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "carrier",
   "profile": "face",
   "depth": "t"
  },
  {
   "op": "sketch",
   "id": "pinhole",
   "plane": {
    "base": "XY",
    "offset": "-(hz + 3)"
   },
   "loops": [
    {
     "name": "pin",
     "circle": {
      "c": [
       "-inset",
       "y_pin"
      ],
      "r": "d_pin / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "pincut",
   "profile": "pinhole",
   "depth": "2 * hz + 6",
   "mode": "cut"
  }
 ]
}
