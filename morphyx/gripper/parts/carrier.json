{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Jaw plate: 32 × 22 × 8, bolted to the outer face of its MGN9C block (four M3 on the block’s 10 × 15 pattern). The Ø4 link pin passes through it along Z with 22 mm of bearing, 10.5 mm inboard of its centre and 5.5 from its inner edge, so the pin sits close to the grip line and the two plates meet on the centre line at closed — that meeting is the stop. Outboard of the pin, the finger mount: four M4 and two Ø5 dowels in two columns, tapped through and closed off by the block behind, so a finger bolt is 8 mm at most. The pin hole is a cut along Z, the only boolean in this design. One extrude along +Y.",
 "params": {
  "half": 16,
  "hz": 11,
  "t": 8,
  "y1": 90,
  "px": 10,
  "pz": 15,
  "d_bolt": 3.4,
  "fx0": 0,
  "fx1": 11,
  "fz": 7,
  "d_finger": 4.3,
  "d_dowel": 5,
  "inset": 10.5,
  "d_pin": 4,
  "y_pin": 86
 },
 "features": [
  {
   "op": "sketch",
   "id": "face",
   "plane": {
    "base": "XZ",
    "offset": "-y1"
   },
   "loops": [
    {
     "name": "outline",
     "rect": {
      "c": [
       0,
       0
      ],
      "w": "2 * half",
      "h": "2 * hz"
     }
    },
    {
     "name": "blockA",
     "circle": {
      "c": [
       "-px/2",
       "-pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockB",
     "circle": {
      "c": [
       "px/2",
       "-pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockC",
     "circle": {
      "c": [
       "-px/2",
       "pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockD",
     "circle": {
      "c": [
       "px/2",
       "pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "fingerA",
     "circle": {
      "c": [
       "fx0",
       "-fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerB",
     "circle": {
      "c": [
       "fx1",
       "-fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerC",
     "circle": {
      "c": [
       "fx0",
       "fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "fingerD",
     "circle": {
      "c": [
       "fx1",
       "fz"
      ],
      "r": "d_finger / 2"
     }
    },
    {
     "name": "dowelA",
     "circle": {
      "c": [
       "fx0",
       0
      ],
      "r": "d_dowel / 2"
     }
    },
    {
     "name": "dowelB",
     "circle": {
      "c": [
       "fx1",
       0
      ],
      "r": "d_dowel / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "carrier",
   "profile": "face",
   "depth": "t"
  },
  {
   "op": "sketch",
   "id": "pinhole",
   "plane": {
    "base": "XY",
    "offset": "-(hz + 3)"
   },
   "loops": [
    {
     "name": "pin",
     "circle": {
      "c": [
       "-inset",
       "y_pin"
      ],
      "r": "d_pin / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "pincut",
   "profile": "pinhole",
   "depth": "2 * hz + 6",
   "mode": "cut"
  }
 ]
}
