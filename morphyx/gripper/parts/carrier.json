{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Finger carrier: a vertical plate bolted to the linear block’s face (four Ø3.4 on the MGN9C 10 × 15 pattern), with two windows the tabs pass through and two Ø3.4 for the pad. side = 1 right, -1 left. One extrude along -Y.",
 "params": {
  "side": 1,
  "x0": -15,
  "x1": 12,
  "z0": -6,
  "z1": 38,
  "t": 6,
  "y1": 120,
  "zr": 16,
  "px": 10,
  "pz": 15,
  "d_bolt": 3.4,
  "win_w": 12.2,
  "win_h": 8.2,
  "wx": -6,
  "wlo": 1,
  "whi": 31,
  "padx": -10,
  "padz": 6,
  "d_pad": 3.4
 },
 "features": [
  {
   "op": "sketch",
   "id": "face",
   "plane": {
    "base": "XZ",
    "offset": "-y1"
   },
   "loops": [
    {
     "name": "outline",
     "rect": {
      "c": [
       "side * (x0 + x1) / 2",
       "(z0 + z1) / 2"
      ],
      "w": "x1 - x0",
      "h": "z1 - z0"
     }
    },
    {
     "name": "windowLo",
     "rect": {
      "c": [
       "side * wx",
       "wlo"
      ],
      "w": "win_w",
      "h": "win_h"
     }
    },
    {
     "name": "windowHi",
     "rect": {
      "c": [
       "side * wx",
       "whi"
      ],
      "w": "win_w",
      "h": "win_h"
     }
    },
    {
     "name": "blockA",
     "circle": {
      "c": [
       "-px/2",
       "zr - pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockB",
     "circle": {
      "c": [
       "px/2",
       "zr - pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockC",
     "circle": {
      "c": [
       "-px/2",
       "zr + pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "blockD",
     "circle": {
      "c": [
       "px/2",
       "zr + pz/2"
      ],
      "r": "d_bolt / 2"
     }
    },
    {
     "name": "padA",
     "circle": {
      "c": [
       "side * padx",
       "zr - padz"
      ],
      "r": "d_pad / 2"
     }
    },
    {
     "name": "padB",
     "circle": {
      "c": [
       "side * padx",
       "zr + padz"
      ],
      "r": "d_pad / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "carrier",
   "profile": "face",
   "depth": "t"
  }
 ]
}
