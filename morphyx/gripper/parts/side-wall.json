       "ya",
       "zr"
      ],
      "r": "d/2"
     }
    },
    {
     "name": "railB",
     "circle": {
      "c": [
       "yb",
       "zr"
      ],
      "r": "d/2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "wall",
   "profile": "face",
   "depth": "t"
  }
 ]
}
