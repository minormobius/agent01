{
 "$schema": "com.minomobi.cad.tree#v1",
 "units": "mm",
 "_": "Fingertip pad: 12 × 20 × 20, bolted to the carrier from behind (two M3 into heat-set inserts, Ø2.5 tap holes here). Its inner X face is the gripping surface, centred on the linear block; the pads meet at x = 0 when closed. side = 1 right, -1 left. One extrude along -Y.",
 "params": {
  "side": 1,
  "w": 12,
  "inset": 6,
  "y1": 140,
  "t": 20,
  "zr": 16,
  "h": 20,
  "d_tap": 2.5,
  "padz": 6,
  "xc": -12
 },
 "features": [
  {
   "op": "sketch",
   "id": "face",
   "plane": {
    "base": "XZ",
    "offset": "-y1"
   },
   "loops": [
    {
     "name": "outline",
     "rect": {
      "c": [
       "side * xc",
       "zr"
      ],
      "w": "w",
      "h": "h"
     }
    },
    {
     "name": "tapA",
     "circle": {
      "c": [
       "side * xc",
       "zr - padz"
      ],
      "r": "d_tap / 2"
     }
    },
    {
     "name": "tapB",
     "circle": {
      "c": [
       "side * xc",
       "zr + padz"
      ],
      "r": "d_tap / 2"
     }
    }
   ]
  },
  {
   "op": "extrude",
   "id": "pad",
   "profile": "face",
   "depth": "t"
  }
 ]
}
