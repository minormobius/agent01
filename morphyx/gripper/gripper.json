{
 "$schema": "com.minomobi.cad.assembly#v1",
 "name": "gripper",
 "_": "Parallel-jaw gripper: NEMA 17 → coupler → T8 lead screw → flange nut in a bracket → saddle with two pins → two 72 mm links → two fingers on sliders riding two 6 mm rails. Kinematic: the drive turns a hidden clock (one turn = one grip cycle); the screw angle `spin` swings 0 → 9 turns → 0 over the cycle, the nut follows by the 2 mm lead (y = 44 closed … 62 open), and the links, sliders and fingers follow the nut: finger pin x = span/2 + √(L² − (pinLine − yn)²). Pads meet at x = 0 when closed; 52.8 mm apart when open. Press spin.",
 "params": {
  "L": 72,
  "span": 40,
  "pinLine": 111,
  "closed": 44,
  "open": 62,
  "lead": 2,
  "linkZ": 36,
  "saddleZ": 30,
  "nutLen": 15,
  "nbT": 8,
  "sliderLen": 24,
  "fingerZ": 22
 },
 "derived": {
  "spin": "360 * ((open - closed) / lead) * (1 - cos(deg(theta))) / 2",
  "yn": "closed + lead * spin / 360",
  "dy": "pinLine - yn",
  "x": "sqrt(L^2 - dy^2)",
  "xf": "span/2 + x",
  "phi": "rad2deg(atan2(dy, x))"
 },
