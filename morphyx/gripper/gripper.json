  "closed": 54,
  "open": 74,
  "lead": 2,
  "xfClosed": 10,
  "pinLine": 68,
  "nutLen": 15,
  "carT": 8,
  "yokeZ": 12,
  "fingerZ": 18,
  "sliderLen": 12,
  "wallX": 40
 },
 "derived": {
