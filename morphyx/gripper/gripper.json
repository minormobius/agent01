{
 "$schema": "com.minomobi.cad.assembly#v1",
 "name": "gripper",
 "_": "Parallel-jaw robot gripper, v3: ISO 9409-1-50-4-M6 flange → NEMA 17 pancake stepper with an integrated Tr8×2 screw → flange nut in a carriage on two Ø6 rods → tapered cam yoke with two 45° slots → pins on two finger tabs → MGN9 blocks on one rail across the front wall → carriers and pads outside. Thrust collar behind the front wall. 84 × 61 × 104 mm case, pads to y = 140. Kinematic: the drive turns a hidden clock (one turn = one grip cycle); the screw angle \\`spin\\` swings 0 → 10 turns → 0, the nut follows by the lead (y = 57 closed … 77 open), the fingers follow one to one: opening 0 → 40 mm. Press spin.",
 "params": {
  "closed": 57,
  "open": 77,
  "lead": 2,
  "xfClosed": 16,
  "pinLine": 88,
  "pinInset": 6,
  "nutLen": 15,
  "flangeT": 3.5,
  "carT": 20,
  "yokeZ": 12,
  "blockL": 28.9
 },
 "derived": {
  "spin": "360 * ((open - closed) / lead) * (1 - cos(deg(theta))) / 2",
  "yn": "closed + lead * spin / 360",
  "xf": "xfClosed + yn - closed",
  "xp": "xf - pinInset"
 },
