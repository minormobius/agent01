      "ratio": 0.5625,
      "handle": "hotrollhottakes.bsky.social",
      "url": "https://bsky.app/profile/hotrollhottakes.bsky.social/post/3mz26e7thek27",
      "uri": "at://did:plc:4gm5uxjg3tz4nat4qpjk2t6h/app.bsky.feed.post/3mz26e7thek27",
