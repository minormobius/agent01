    {
      "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:4gm5uxjg3tz4nat4qpjk2t6h/bafkreigk36sowfupo2f26deb642qesl3o7bkrvznjhawvvkoxxw7ei25jm",
      "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4gm5uxjg3tz4nat4qpjk2t6h/bafkreigk36sowfupo2f26deb642qesl3o7bkrvznjhawvvkoxxw7ei25jm",
