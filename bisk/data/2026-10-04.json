      "handle": "norvid-studies.bsky.social",
      "url": "https://bsky.app/profile/norvid-studies.bsky.social/post/3mx2oo73iss2d",
      "uri": "at://did:plc:mssgex5rqek4wc66wgvzztbc/app.bsky.feed.post/3mx2oo73iss2d",
