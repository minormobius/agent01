{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kata",
  "compatibility_date": "2026-02-20",
  // kata: four dimensions, ridden. A landing page and its demos (lean/, the track), toward vehicles you pilot in 4D.
  // No build, no worker script, no bindings: the directory IS the site. CLAUDE.md, tests and this file are kept out of
  // the upload by .assetsignore.
  "assets": {
    "directory": "."
  },
  // A PLAIN ROUTE, not a custom domain: it costs none of the zone's custom-domain slots. A route makes no DNS, so
  // deploy-kata.yml runs scripts/route-dns.mjs before wrangler deploy.
  "routes": [
    { "pattern": "kata.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
