   "bell_beat_hz": 2.716,
   "words": "Toll for the year / that would not stay; / every hand true, / still we fell away."
  },
  {
   "section": "lap3",
   "at": 43.2,
   "tonic_cents": -43.013,
   "bell_beat_hz": 5.399,
   "words": "Ring for the friends / gone in the snow; / each kept the tune, / each a comma low."
  },
