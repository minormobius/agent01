{
  "$schema": "com.minomobi.cad.assembly#v1",
  "name": "lift",
  "_": "A lead-screw lift, and three things an assembly can now say. The screw is driven; a `screw` mate moves the nut up the screw by `lead` per turn; a `fixed` mate carries the platform with the nut. The four bolts are one component with `repeat: 4`, each placed by reference — `at: \"@platform.pivot[i]\"` — on the platform's own holes, aligned to the bore's axis, so they ride up with it without a mate of their own. Every number below is the document's; nothing was measured by hand. `fits` records the three clearances the design intends — nut on screw, bolts in their holes, the screw through the platform's centre — so the clearance check reads them as fits, not as pairs too close.",
  "params": {
    "lead": 2,
    "rise": 10,
    "R": 12,
    "bolt_r": 0.5
  },
  "parts": {
    "screw": {
      "units": "mm",
      "params": {
        "r": 1.2,
        "L": 40,
        "flat": 0.9
      },
      "features": [
        {
          "op": "sketch",
          "id": "profile",
          "loops": [
            {
              "name": "shaft",
              "path": {
                "from": [
                  "flat",
                  "sqrt(r^2 - flat^2)"
                ],
                "segs": [
                  {
                    "arc": {
                      "via": [
                        "-r",
                        0
                      ],
                      "to": [
                        "flat",
                        "-sqrt(r^2 - flat^2)"
                      ]
                    }
                  },
                  {
                    "to": [
                      "flat",
                      "sqrt(r^2 - flat^2)"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "op": "extrude",
          "id": "screw",
          "profile": "profile",
          "depth": "L"
        }
      ]
    },
    "nut": {
      "units": "mm",
      "params": {
        "w": 8,
        "h": 4,
        "bore": 1.3
      },
      "features": [
        {
          "op": "sketch",
          "id": "outline",
          "loops": [
            {
              "name": "body",
              "rect": {
                "c": [
                  0,
                  0
                ],
                "w": "w",
                "h": "w"
              }
            },
            {
              "name": "bore",
              "circle": {
                "c": [
                  0,
                  0
                ],
                "r": "bore"
              }
            }
          ]
        },
        {
          "op": "extrude",
          "id": "nut",
          "profile": "outline",
          "depth": "h"
        }
      ]
    },
    "platform": "bench:plate",
    "bolt": {
      "units": "mm",
      "params": {
        "r": 0.5,
        "h": 6,
        "head": 1.1,
        "cap": 1
      },
      "features": [
        {
          "op": "sketch",
          "id": "profile",
          "plane": "XZ",
          "loops": [
            {
              "name": "bolt",
              "polygon": [
                [
                  0,
                  0
                ],
                [
                  "r",
                  0
                ],
                [
                  "r",
                  "h"
                ],
                [
                  "head",
                  "h"
                ],
                [
                  "head",
                  "h + cap"
                ],
                [
                  0,
                  "h + cap"
                ]
              ]
            }
          ]
        },
        {
          "op": "revolve",
          "id": "bolt",
          "profile": "profile",
          "axis": {
            "p": [
              0,
              0
            ],
            "d": [
              0,
              1
            ]
          }
        }
      ]
    }
  },
  "components": [
    {
      "id": "screw",
      "part": "screw",
      "at": [
        0,
        0,
        0
      ]
    },
    {
      "id": "nut",
      "part": "nut",
      "at": [
        0,
        0,
        "rise"
      ]
    },
    {
      "id": "platform",
      "part": "platform",
      "params": {
        "R": "R",
        "t": 1.5,
        "r_pivot": "bolt_r + 0.1",
        "r_pivots": "R - 3",
        "n_pivots": 4,
        "r_centre": 1.4,
        "r_pillar": 0.4,
        "r_pillars": "R - 1.2",
        "n_pillars": 3
      },
      "at": [
        0,
        0,
        "rise + 4"
      ]
    },
    {
      "id": "bolt",
      "part": "bolt",
      "repeat": 4,
      "params": {
        "r": "bolt_r"
      },
      "at": "@platform.pivot[i]",
      "rotate": {
        "align": "@platform.pivot[i]"
      },
      "offset": [
        0,
        0,
        -2
      ]
    }
  ],
  "mates": [
    {
      "kind": "screw",
      "a": "screw",
      "b": "nut",
      "lead": "lead"
    },
    {
      "kind": "fixed",
      "a": "nut",
      "b": "platform"
    }
  ],
  "drive": {
    "component": "screw",
    "rpm": 60
  },
  "fits": [
    {
      "a": "screw",
      "b": "nut",
      "min": 0.05,
      "max": 0.15
    },
    {
      "a": "platform",
      "b": "bolt[*]",
      "min": 0.05,
      "max": 0.15
    },
    {
      "a": "screw",
      "b": "platform",
      "min": 0.15,
      "max": 0.3
    }
  ]
}
