{
  "$schema": "com.minomobi.cad.tree#v1",
  "units": "mm",
  "_": "Pallet fork: an anchor pivoted at the origin, its two pallet stones sitting `clear` outside the escape wheel's tip circle (1.3 mm: enough that a full ±8° rock never carries a stone into the teeth) at ±span from the line of centres (the wheel centre is d below the pivot), with a lever running up to the balance. One closed polygon plus the pivot hole. The kinematic mock never lets a pallet enter a tooth space, so the interference check stays clean; a real escapement geometry is a later, exact job.",
  "params": {
    "r_tip": 12,
    "d": 14.356,
    "span": 30,
    "half": 3,
    "clear": 1.3,
    "stone": 1.4,
    "arm": 1.0,
    "boss": 1.4,
    "lever": 8,
    "pivot": 0.5,
    "b": 0.6
  },
  "features": [
    {
      "op": "sketch",
      "id": "anchor",
      "loops": [
        {
          "name": "outline",
          "polygon": [
            [
              "-arm/2",
              "lever"
            ],
            [
              "arm/2",
              "lever"
            ],
            [
              "arm/2",
              "boss"
            ],
            [
              "boss",
              "boss/2"
            ],
            [
              "(r_tip+clear+stone)*sin(deg(span-half))",
              "-d + (r_tip+clear+stone)*cos(deg(span-half))"
            ],
            [
              "(r_tip+clear+stone)*sin(deg(span+half))",
              "-d + (r_tip+clear+stone)*cos(deg(span+half))"
            ],
            [
              "(r_tip+clear)*sin(deg(span+half))",
              "-d + (r_tip+clear)*cos(deg(span+half))"
            ],
            [
              "(r_tip+clear)*sin(deg(span-half))",
              "-d + (r_tip+clear)*cos(deg(span-half))"
            ],
            [
              "boss - 0.3",
              "-boss"
            ],
            [
              "-boss + 0.3",
              "-boss"
            ],
            [
              "-(r_tip+clear)*sin(deg(span-half))",
              "-d + (r_tip+clear)*cos(deg(span-half))"
            ],
            [
              "-(r_tip+clear)*sin(deg(span+half))",
              "-d + (r_tip+clear)*cos(deg(span+half))"
            ],
            [
              "-(r_tip+clear+stone)*sin(deg(span+half))",
              "-d + (r_tip+clear+stone)*cos(deg(span+half))"
            ],
            [
              "-(r_tip+clear+stone)*sin(deg(span-half))",
              "-d + (r_tip+clear+stone)*cos(deg(span-half))"
            ],
            [
              "-boss",
              "boss/2"
            ],
            [
              "-arm/2",
              "boss"
            ]
          ]
        },
        {
          "name": "pivot",
          "circle": {
            "c": [
              0,
              0
            ],
            "r": "pivot"
          }
        }
      ]
    },
    {
      "op": "extrude",
      "id": "fork",
      "profile": "anchor",
      "depth": "b"
    }
  ]
}
