{
  "$schema": "com.minomobi.cad.tree#v1",
  "units": "mm",
  "_": "A clock hand: a round boss with a bore and a tapered blade along +x, as one outline — the blade's edges meet the boss circle and an arc closes it the long way round — so no boolean is needed.",
  "params": { "length": 20, "width": 1.6, "tip": 0.4, "boss": 2.0, "bore": 0.6, "b": 0.4 },
  "features": [
    { "op": "sketch", "id": "outline", "loops": [
      { "name": "hand", "path": { "from": ["sqrt(boss^2 - (width/2)^2)", "width/2"], "segs": [
        { "to": ["length", "tip/2"] },
        { "to": ["length", "-tip/2"] },
        { "to": ["sqrt(boss^2 - (width/2)^2)", "-width/2"] },
        { "arc": { "via": ["-boss", 0], "to": ["sqrt(boss^2 - (width/2)^2)", "width/2"] } } ] } },
      { "name": "bore", "circle": { "c": [0, 0], "r": "bore" } } ] },
    { "op": "extrude", "id": "hand", "profile": "outline", "depth": "b" }
  ]
}
