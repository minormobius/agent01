# cad.mino.mobi — the egress boundary for this surface.
#
# This file, not worker.js, is what applies: Workers Static Assets serves an
# asset match directly without invoking the Worker.
#
# Self-contained: the engine wasm, the Manifold module, the bench trees and the
# ES modules all ship with the site, so connect-src is 'self'. The build runs
# in a module Worker (worker-src 'self'); 'wasm-unsafe-eval' permits
# WebAssembly.instantiate and nothing else. blob: in img-src is the snapshot
# strip and the STL download.
#
# One deliberate exception, confined: Manifold's Emscripten/embind glue
# generates every method invoker with `new Function`, so it needs
# 'unsafe-eval'. A dedicated Worker takes its CSP from its *own* script's
# response headers, so the permission is granted to /build-worker.js only —
# the page, which handles the DOM and the URL, keeps the strict policy.
# browser.selftest.mjs loads the page under these exact rules and fails if
# either policy is wrong. The live host must answer / and /build-worker.js
# with exactly one CSP each (curl -I both).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# connect-src: 'self' covers the engine, the bench trees and the /xrpc/ read
# gateway in worker.js (any public repo, proxied, so the page never talks to a
# PDS host directly); auth.mino.mobi is the shared OAuth worker, which holds
# the tokens and proxies the signed-in user's writes.
#
# The page policy goes on the document responses only. A CSP header on a
# script or wasm response is inert (a dedicated Worker's script is the one
# exception, below), so putting it on /* only invites the rule-combining
# question; here there is no overlap to combine.
/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://auth.mino.mobi; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://auth.mino.mobi; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# The worker may also import OCCT (66 MB) from unpkg on demand — jsDelivr
# refuses files that size — so its script-src and connect-src name that host.
/build-worker.js
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://unpkg.com; connect-src 'self' https://unpkg.com; base-uri 'none'; object-src 'none'

/cad.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=3600

/vendor/manifold.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=86400
