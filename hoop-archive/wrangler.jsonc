{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoop-archive",
  "main": "worker.js",
  "compatibility_date": "2026-03-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // GOLDEN RULE: this `name` must be the worker that owns the live custom domain,
  // and the domain must be declared here as a custom_domain route — otherwise
  // wrangler silently updates a stray hoop-archive.workers.dev and the subdomain
  // never changes. Verify the deploy log binds "hoop-archive.mino.mobi (custom domain)".
  "routes": [
    { "pattern": "hoop-archive.mino.mobi", "custom_domain": true }
  ],
  // HoopRoom: live presence for the archived first-pass room (the root @-glyph
  // forum game). Its own DO namespace — a separate room from mainline hoop's.
  // In-memory only; eviction just drops the live socket set.
  "durable_objects": {
    "bindings": [
      { "name": "HOOP_ROOM", "class_name": "HoopRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HoopRoom"] }
  ]
}
