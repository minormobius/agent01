{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ns",
  "compatibility_date": "2026-02-20",
  // Static explainer pack on the 2026 forced Navier–Stokes blowup paper.
  // No build, no worker script, no bindings: the directory IS the site.
  // CLAUDE.md is kept out of the upload by .assetsignore.
  "assets": {
    "directory": "."
  },
  // A PLAIN ROUTE, not a custom domain. ns.mino.mobi was a custom domain until
  // 2026-09-23, when it was detached to free one of the zone's 100 slots; it is back
  // as a route, which costs no slot (routes cap at 1000). A route makes no DNS, so
  // deploy-ns.yml runs scripts/route-dns.mjs before wrangler deploy. Do NOT turn this
  // back into a custom_domain: that would spend a slot for nothing.
  "routes": [
    { "pattern": "ns.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
