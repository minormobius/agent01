{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imp",
  "compatibility_date": "2026-09-20",
  // An independent evaluation of Imp (deepfates' DSPy port to Elixir), published
  // from the bakeoff/imp rig. No build, no worker script, no bindings: the
  // directory IS the site. CLAUDE.md is kept out of the upload by .assetsignore.
  "assets": {
    "directory": "."
  },
  // A PLAIN ROUTE, not a custom domain: it costs none of the zone's 100
  // custom-domain slots (routes cap at 1000). A route makes no DNS, so
  // deploy-imp.yml runs scripts/route-dns.mjs before wrangler deploy.
  "routes": [
    { "pattern": "imp.mino.mobi/*", "zone_name": "mino.mobi" }
  ]
}
