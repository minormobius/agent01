// cAT — DECOMMISSIONED. See worker.js for why.
//
// Everything this worker used to reach is deliberately gone: no `assets`
// (nothing to serve), no `d1_databases` (cannot write cat_posts), no
// `durable_objects` (cannot open a Jetstream socket), no `triggers.crons`
// (nothing wakes it up). The `v2` migration deletes the CatListener Durable
// Object and its stored state; a Durable Object class removed from the code
// MUST be declared in `deleted_classes` or `wrangler deploy` fails.
//
// `name` and `routes` are unchanged ON PURPOSE. cat-firehose is the worker
// that owns the live custom domain, so this is the config that actually
// replaces the running site — the golden rule in ../docs/DEPLOYS.md. Point
// this at any other name and the deploy goes green while the feed keeps
// running.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-firehose",
  "main": "worker.js",
  "compatibility_date": "2026-02-20",
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CatListener"] },
    { "tag": "v2", "deleted_classes": ["CatListener"] }
  ],
  "routes": [
    { "pattern": "cat.mino.mobi", "custom_domain": true }
  ]
}
